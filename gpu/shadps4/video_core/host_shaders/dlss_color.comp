// sotc: DLSS Super Resolution input preparation. The game's presented image is converted to
// RGBA16F for NGX; an sRGB-format source is decoded by the sampler and encoded back here so
// that DLSS receives display-referred (sRGB) values, which is what its SDR mode expects. An
// A2R10G10B10 source is sampled through a UNORM view and is already encoded, so it is copied
// unchanged (the shader is built twice: DLSS_COLOR_ENCODE 0 and 1).

#version 450 core
#extension GL_EXT_samplerless_texture_functions : require

layout (local_size_x = 8, local_size_y = 8) in;

layout (binding = 0, set = 0) uniform texture2D color_in;
layout (binding = 1, set = 0, rgba16f) uniform writeonly image2D color_out;
layout (binding = 2, set = 0) uniform sampler color_sampler;

layout (push_constant) uniform Params {
    uvec2 size;
} pc;

vec3 linear_to_srgb(vec3 c) {
    // The exact sRGB transfer function; negatives and values above 1 are clamped first.
    c = clamp(c, 0.0, 1.0);
    return mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, 12.92 * c, lessThan(c, vec3(0.0031308)));
}

void main() {
    const uvec2 at = gl_GlobalInvocationID.xy;
    if (at.x >= pc.size.x || at.y >= pc.size.y) {
        return;
    }
    const vec4 c = texelFetch(sampler2D(color_in, color_sampler), ivec2(at), 0);
#if DLSS_COLOR_ENCODE
    imageStore(color_out, ivec2(at), vec4(linear_to_srgb(c.rgb), c.a));
#else
    imageStore(color_out, ivec2(at), c);
#endif
}
